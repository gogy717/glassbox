{
  "name": "glassbox",
  "version": "0.1.1",
  "private": true,
  "description": "Live viewer for Claude Code: what it's doing, the tool-call chain, and where tokens go — including multi-agent runs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogy717/glassbox.git"
  },
  "homepage": "https://github.com/gogy717/glassbox#readme",
  "bugs": {
    "url": "https://github.com/gogy717/glassbox/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "glassbox": "dist/server/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts --demo --no-open",
    "dev:live": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server:live\" \"npm:dev:web\"",
    "dev:server:live": "tsx watch src/server/cli.ts --no-open",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tanstack/react-virtual": "^3.14.22",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-json-view-lite": "^2.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ]
}
